     [
      "ret_conf_pct",
      "<",
      0.2
     ]
    ],
    "then": "escalate",
    "skip": 1,
    "text": "IF the first retriever is unsure (lowest 20%) THEN escalate, skipping one size, and ensemble"
   },
   {
    "id": "R2",
    "stage": "retrieval",
    "when": [
     [
      "rung",
      ">=",
      1
     ],
     [
      "ret_agree",
      "==",
      0
     ],
     [
      "ret_conf_pct",
      "<",
      0.2
     ]
    ],
    "then": "escalate",
    "text": "IF after escalating the shortlists disagree AND the bigger retriever is also unsure THEN escalate again and ensemble"
   },
   {
    "id": "H2",
    "stage": "answer",
    "hard": true,
    "when": [
     [
      "is_cannot",
      "==",
      1
     ]
    ],
    "then": "escalate",
    "text": "IF the answer is empty or says it cannot be determined THEN escalate (locked)"
   },
   {
    "id": "A2",
    "stage": "answer",
    "when": [
     [
      "is_yes_no",
      "==",
      1
     ]
    ],
    "then": "keep",
    "text": "IF the answer is yes/no THEN keep it"
   },
   {
    "id": "A1",
    "stage": "answer",
    "when": [
     [
      "words_in_passages",
      "<",
      0.97
     ]
    ],
    "then": "escalate",
    "text": "IF some of the answer's words are not in the passages THEN escalate; agree -> accept, else vote"
   },
   {
    "id": "A3",
    "stage": "answer",
    "when": [
     [
      "ans_conf_pct",
      "<",
      0.15
     ]
    ],
    "then": "escalate",
    "text": "IF the answerer's token confidence is in its lowest 15% THEN escalate"
   }
  ]
 },
