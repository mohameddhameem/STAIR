      "<",
      0.1
     ]
    ],
    "then": "escalate",
    "text": "IF the first retriever's confidence is in its lowest 10% THEN escalate retrieval (locked)"
   },
   {
    "id": "R1",
    "stage": "retrieval",
    "at": [
     0
    ],
