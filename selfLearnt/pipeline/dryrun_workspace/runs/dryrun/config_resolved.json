    1,
    "l70",
    1
   ]
  },
  "ws3": {
   "name": "Hidden-state probe + calibrated rules (AgentTTS's models, untrained)",
   "kind": "rules",
   "retrievers": [
    "q7",
    "q32",
    "q72"
   ],
   "answerers": [
    "l3",
    "l8",
    "l70"
   ],
   "signals": [
    "ret_probe_pct",
    "ans_probe_pct",
    "is_cannot",
    "rung"
   ],
   "seed_rules": [
    {
     "id": "H1",
     "stage": "retrieval",
     "hard": true,
     "at": [
      0
     ],
     "when": [
      [
       "ret_probe_pct",
       "<",
       0.1
      ]
     ],
     "then": "escalate",
     "text": "IF the first retriever's probe score is in its lowest 10% THEN escalate (locked)"
    },
    {
     "id": "R1",
     "stage": "retrieval",
     "when": [
      [
       "ret_probe_pct",
       "<",
       0.25
      ]
     ],
     "then": "escalate",
     "text": "IF the probe says this shortlist is likely incomplete (lowest 25%) THEN escalate to the next retriever and ensemble"
    },
    {
     "id": "H2",
     "stage": "answer",
     "hard": true,
     "when": [
      [
       "is_cannot",
       "==",
       1
      ]
     ],
     "then": "escalate",
     "text": "IF the answer is empty or says it cannot be determined THEN escalate (locked)"
    },
    {
     "id": "A1",
     "stage": "answer",
     "when": [
      [
       "ans_probe_pct",
       "<",
       0.3
      ]
     ],
     "then": "escalate",
     "text": "IF the probe says the answer is likely wrong (lowest 30%) THEN escalate to the next answerer"
    }
   ]
  },
  "ws4": {
   "name": "Our fine-tuning + self-learnt rules (AgentTTS's models)",
   "kind": "rules",
   "retrievers": [
    "q7:ft",
    "q32:ft",
    "q72:ft"
   ],
   "answerers": [
    "l3:ft",
    "l8:ft",
    "l70:ft"
   ],
   "signals": "all",
   "seed_rules": [
    {
     "id": "H1",
     "stage": "retrieval",
     "hard": true,
     "at": [
      0
     ],
     "when": [
      [
       "ret_conf_pct",
       "<",
       0.1
      ]
     ],
     "then": "escalate",
     "text": "IF the first retriever's confidence is in its lowest 10% THEN escalate retrieval (locked)"
    },
    {
     "id": "R1",
     "stage": "retrieval",
     "at": [
      0
     ],
     "when": [
      [
       "ret_conf_pct",
       "<",
       0.2
      ]
     ],
     "then": "escalate",
     "skip": 1,
     "text": "IF the first retriever is unsure (lowest 20%) THEN escalate, skipping one size, and ensemble"
    },
    {
     "id": "R2",
     "stage": "retrieval",
     "when": [
      [
       "rung",
       ">=",
       1
      ],
      [
       "ret_agree",
       "==",
       0
      ],
      [
       "ret_conf_pct",
       "<",
       0.2
      ]
     ],
     "then": "escalate",
     "text": "IF after escalating the shortlists disagree AND the bigger retriever is also unsure THEN escalate again and ensemble"
    },
    {
     "id": "H2",
     "stage": "answer",
     "hard": true,
     "when": [
      [
       "is_cannot",
       "==",
       1
      ]
     ],
     "then": "escalate",
     "text": "IF the answer is empty or says it cannot be determined THEN escalate (locked)"
    },
    {
     "id": "A2",
     "stage": "answer",
     "when": [
      [
       "is_yes_no",
       "==",
       1
      ]
     ],
     "then": "keep",
     "text": "IF the answer is yes/no THEN keep it"
    },
    {
     "id": "A1",
     "stage": "answer",
     "when": [
      [
       "words_in_passages",
       "<",
       0.97
      ]
     ],
     "then": "escalate",
     "text": "IF some of the answer's words are not in the passages THEN escalate; agree -> accept, else vote"
    },
    {
     "id": "A3",
     "stage": "answer",
     "when": [
      [
       "ans_conf_pct",
       "<",
       0.15
      ]
     ],
     "then": "escalate",
     "text": "IF the answerer's token confidence is in its lowest 15% THEN escalate"
    }
   ]
  },
