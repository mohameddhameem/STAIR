# Cluster settings for the SMU Origami GPU cluster. Put YOUR values (account, storage path) in jobs/cluster.local.env,
# which overrides this file and is never committed (the repository is public).
# EDIT the lines marked EDIT (run `myinfo` on the login node to see yours).
# Read by jobs/submit_all.py (job headers) and jobs/job.sbatch (environment). Never put a token in this file.

PARTITION=researchlong          # EDIT: your assigned partition (myinfo); researchlong allows 5 days, jobs may be pre-empted (they resume)
ACCOUNT=EDIT_ACCOUNT            # EDIT: your account (myinfo)
QOS=research-1-qos              # EDIT: your QOS (myinfo)
MAIL=                           # optional: e-mail for job end / failure, e.g. you@smu.edu.sg
CONSTRAINT="l40s|h100|h100nvl|a40|a100|l40"    # 40 GB+ GPUs, for the 32B/70B/72B models and the 7B/8B training (not V100: no bfloat16)
CONSTRAINT_SMALL="a5000|3090|l40s|h100|h100nvl|a40|a100|l40"   # also 24 GB GPUs: inference up to 7B, training up to 3B
                                     # Fewer pre-emptions: prefix "nopreempt&(...)" if such nodes are free
CPUS=10                         # research-1-qos: up to 10 CPU cores
MEM=120G                        # research-1-qos: up to 128 GB RAM

# Storage for models, data and runs (~700 GB). Check your quota first (e.g. `df -h ~`, `quota -s`); ask SCIS IT if it is smaller
export STAIR_PROJECT_DIR=EDIT_/path/with/700GB/stair    # e.g. $HOME/stair-data if your home quota allows
export STAIR_STATUS_PUSH=1      # 1 = push the status page to branch selfLearnt-runs (needs ~/.stair_github_token); 0 = keep it local
# Hugging Face token for the gated Llama models: run `huggingface-cli login` once on the login node (not stored here).

# Environment (created once by jobs/install_env.sh)
PY_MODULE=Python/3.11.7         # EDIT if `module spider Python` shows another 3.11 version
CUDA_MODULE=CUDA/12.4.0         # the cluster's module for PyTorch jobs
VENV=$HOME/stair-env
CONFIG=configs/default.yaml
